APP_NAME=GridCloud
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-RAILWAY-DOMAIN.up.railway.app
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=YOUR_POSTGRES_HOST
DB_PORT=5432
DB_DATABASE=YOUR_POSTGRES_DATABASE
DB_USERNAME=YOUR_POSTGRES_USERNAME
DB_PASSWORD=YOUR_POSTGRES_PASSWORD
DB_SSLMODE=prefer

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
# Uploads use the private_uploads disk at storage/app/private/uploads.
# Mount the Railway Volume at /app/storage/app/private/uploads.

LECTURER_PASSWORD=SET_A_LONG_RANDOM_PASSWORD
LECTURER_TOKEN_TTL=43200

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

FRONTEND_URL=https://YOUR-NETLIFY-SITE.netlify.app,http://localhost:3000

BCRYPT_ROUNDS=12
